# Copy this file to .env.local for the local scripts, and enter the same values in
# Vercel → Project → Settings → Environment Variables (Production).
# NEVER commit .env.local — it is in .gitignore.

# --- Google OAuth (README step 2-3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The job-application Gmail address. Pushes for any other address are ignored.
GMAIL_ADDRESS=

# Pub/Sub topic, format: projects/<project-id>/topics/<topic-name>
PUBSUB_TOPIC=projects/my-project/topics/gmail-job-inbox

# --- Secrets: generate each with  openssl rand -hex 32  (64 characters, URL-safe) ---
# Sent by Pub/Sub as ?key=... on every push.
WEBHOOK_SECRET=
# Sent by Vercel Cron as "Authorization: Bearer ...".
CRON_SECRET=

# --- OpenRouter ---
OPENROUTER_API_KEY=
# Comma-separated, primary first, then fallbacks. Pick current free models at
# https://openrouter.ai/models (filter: free / prompt price 0). IDs end in ":free".
OPENROUTER_MODELS=

# --- Behaviour ---
# true  = classify and log only, never add labels (start here!)
# false = actually add labels
DRY_RUN=true
PUSH_LOOKBACK_DAYS=2
SWEEP_LOOKBACK_DAYS=7
MAX_MESSAGES_PER_RUN=10
RUN_TIME_BUDGET_SECONDS=45

# --- Local only (not needed in Vercel) ---
# Your real personal details, comma-separated. check-fixtures fails if any of these
# appear in test fixtures. Example: Firstname Lastname,me@gmail.com,9876543210,Pune
FIXTURE_DENYLIST=
