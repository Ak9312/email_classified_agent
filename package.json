{
  "name": "job-inbox-classifier",
  "version": "1.0.0",
  "private": true,
  "description": "Labels a job-application Gmail inbox: Gmail watch -> Pub/Sub -> Vercel -> OpenRouter free model -> add label only.",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "npm run check-fixtures && vitest run",
    "typecheck": "tsc --noEmit",
